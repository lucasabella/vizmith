# Copy to .env. This is the checkout's way in; an installed Vizmith uses
# `vizmith configure`, which writes the same names to config.env in the state directory.
# Nearest wins: a real environment variable, then this file, then that one.

# Which kind of source this is: databricks or duckdb. Unset means databricks, which is
# what shipped first. Only the settings of the kind named here have to be filled in.
VIZMITH_SOURCE=

# A profile in ~/.databrickscfg, created by `databricks auth login`.
VIZMITH_DATABRICKS_PROFILE=
# The catalog and schema a spec's table names are resolved against.
VIZMITH_DATABRICKS_CATALOG=
VIZMITH_DATABRICKS_SCHEMA=
# The SQL warehouse that runs the query.
VIZMITH_DATABRICKS_WAREHOUSE=

# A DuckDB file on this machine, opened read only, for VIZMITH_SOURCE=duckdb. The database
# and the schema are what a spec's table names are resolved against, the way the catalog
# and the schema are on a warehouse. `pip install vizmith[duckdb]` installs the driver.
VIZMITH_DUCKDB_PATH=
VIZMITH_DUCKDB_DATABASE=
VIZMITH_DUCKDB_SCHEMA=

# A BigQuery project and dataset, for VIZMITH_SOURCE=bigquery. Credentials are the client
# library's own: gcloud application default credentials, or GOOGLE_APPLICATION_CREDENTIALS.
# The location is where jobs run — EU, us-central1 — and may be left empty for the default.
# `pip install vizmith[bigquery]` installs the client. Nobody has run Vizmith against a real
# project yet; see docs/compatibility.md for what that means.
VIZMITH_BIGQUERY_PROJECT=
VIZMITH_BIGQUERY_DATASET=
VIZMITH_BIGQUERY_LOCATION=

# The model that writes a spec. Any endpoint speaking the OpenAI chat completions
# convention; the base URL is the part before /chat/completions.
VIZMITH_MODEL_BASE_URL=
VIZMITH_MODEL_NAME=
VIZMITH_MODEL_KEY=

# Where the server keeps what it has to remember between runs: what you answered about a
# suggested relationship, the profiles it has already paid the warehouse for, the
# dashboards you saved, and the config.env that `vizmith configure` writes. Defaults to
# ~/.vizmith. That last file holds the names above, this key among them, and is written
# readable by you and nobody else.
VIZMITH_STATE_DIR=
