# Copy to .env. This is the checkout's way in; an installed Vizmith uses
# `vizmith configure`, which writes the same names to config.env in the state directory.
# Nearest wins: a real environment variable, then this file, then that one.

# Which kind of source this is: databricks or duckdb. Unset means databricks, which is
# what shipped first. Only the settings of the kind named here have to be filled in.
VIZMITH_SOURCE=

# A profile in ~/.databrickscfg, created by `databricks auth login`.
VIZMITH_DATABRICKS_PROFILE=
# The catalog and schema a spec's table names are resolved against.
VIZMITH_DATABRICKS_CATALOG=
VIZMITH_DATABRICKS_SCHEMA=
# The SQL warehouse that runs the query.
VIZMITH_DATABRICKS_WAREHOUSE=

# A DuckDB file on this machine, opened read only, for VIZMITH_SOURCE=duckdb. The database
# and the schema are what a spec's table names are resolved against, the way the catalog
# and the schema are on a warehouse. `pip install vizmith[duckdb]` installs the driver.
VIZMITH_DUCKDB_PATH=
VIZMITH_DUCKDB_DATABASE=
VIZMITH_DUCKDB_SCHEMA=

# A BigQuery project and dataset, for VIZMITH_SOURCE=bigquery. Credentials are the client
# library's own: gcloud application default credentials, or GOOGLE_APPLICATION_CREDENTIALS.
# The location is where jobs run — EU, us-central1 — and may be left empty for the default.
# `pip install vizmith[bigquery]` installs the client. Nobody has run Vizmith against a real
# project yet; see docs/compatibility.md for what that means.
VIZMITH_BIGQUERY_PROJECT=
VIZMITH_BIGQUERY_DATASET=
VIZMITH_BIGQUERY_LOCATION=

# A Snowflake connection, for VIZMITH_SOURCE=snowflake. The name is a connection in
# ~/.snowflake/connections.toml, which is where the account, the user and whatever
# authenticates them live — the same shape as the Databricks profile above, and the reason
# no Snowflake credential is stored here. `pip install vizmith[snowflake]` installs the
# connector. Nobody has run Vizmith against a real account yet.
VIZMITH_SNOWFLAKE_CONNECTION=
VIZMITH_SNOWFLAKE_DATABASE=
VIZMITH_SNOWFLAKE_SCHEMA=
VIZMITH_SNOWFLAKE_WAREHOUSE=

# A PostgreSQL schema, for VIZMITH_SOURCE=postgres. The service is a name in
# ~/.pg_service.conf; leave it empty to use the standard PGHOST, PGDATABASE and PGUSER
# environment instead. A connection is bound to one database, so a spec's names here are
# schema.table rather than catalog.schema.table. `pip install vizmith[postgres]` installs
# the driver. Nobody has run Vizmith against a real server yet.
VIZMITH_POSTGRES_SERVICE=
VIZMITH_POSTGRES_SCHEMA=

# The model that writes a spec. Any endpoint speaking the OpenAI chat completions
# convention; the base URL is the part before /chat/completions.
VIZMITH_MODEL_BASE_URL=
VIZMITH_MODEL_NAME=
VIZMITH_MODEL_KEY=

# Where the server keeps what it has to remember between runs: what you answered about a
# suggested relationship, the profiles it has already paid the warehouse for, the
# dashboards you saved, and the config.env that `vizmith configure` writes. Defaults to
# ~/.vizmith. That last file holds the names above, this key among them, and is written
# readable by you and nobody else.
VIZMITH_STATE_DIR=

# How often the endpoints that spend money may be asked to. `/api/ask` and `/api/critique`
# make billed model calls; `/api/execute` and the two metadata endpoints run warehouse
# statements. Nothing else is rationed, because nothing else costs anything.
#
# Both are a rate and a burst at once: a bucket of that many tokens, refilling at that many
# a minute. The query default is five times the tile cap, so opening a full dashboard —
# every tile at once, which is the largest burst anybody makes on purpose — goes through
# untouched. Set either to 0 to turn it off, which is what a batch caller such as the eval
# harness wants, since a ration exists to catch a loop nobody meant.
VIZMITH_MODEL_PER_MINUTE=
VIZMITH_QUERY_PER_MINUTE=

# How many costed requests may be running at once, across every client. A rate says how
# many may start in a minute and nothing about how many may be in flight, and statements
# waiting on a slow warehouse are statements being paid for. Defaults to the tile cap, 24,
# for the same reason as above. 0 turns it off.
VIZMITH_IN_FLIGHT=
