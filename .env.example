# Copy to .env. The serve command reads it; a real environment variable wins over it.
# A profile in ~/.databrickscfg, created by `databricks auth login`.
VIZMITH_DATABRICKS_PROFILE=
# The catalog and schema a spec's table names are resolved against.
VIZMITH_DATABRICKS_CATALOG=
VIZMITH_DATABRICKS_SCHEMA=
# The SQL warehouse that runs the query.
VIZMITH_DATABRICKS_WAREHOUSE=
