# Copy to .env. This is the checkout's way in; an installed Vizmith uses
# `vizmith configure`, which writes the same names to config.env in the state directory.
# Nearest wins: a real environment variable, then this file, then that one.
# A profile in ~/.databrickscfg, created by `databricks auth login`.
VIZMITH_DATABRICKS_PROFILE=
# The catalog and schema a spec's table names are resolved against.
VIZMITH_DATABRICKS_CATALOG=
VIZMITH_DATABRICKS_SCHEMA=
# The SQL warehouse that runs the query.
VIZMITH_DATABRICKS_WAREHOUSE=

# The model that writes a spec. Any endpoint speaking the OpenAI chat completions
# convention; the base URL is the part before /chat/completions.
VIZMITH_MODEL_BASE_URL=
VIZMITH_MODEL_NAME=
VIZMITH_MODEL_KEY=

# Where the server keeps what it has to remember between runs: what you answered about a
# suggested relationship, the profiles it has already paid the warehouse for, the
# dashboards you saved, and the config.env that `vizmith configure` writes. Defaults to
# ~/.vizmith. That last file holds the names above, this key among them, and is written
# readable by you and nobody else.
VIZMITH_STATE_DIR=
