{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vizmith.dev/spec/v1/spec.schema.json",
  "title": "Vizmith visualisation spec, version 1",
  "type": "object",
  "required": ["spec_version", "query", "chart"],
  "additionalProperties": false,
  "properties": {
    "spec_version": { "const": "1" },
    "title": { "type": "string", "maxLength": 200 },
    "query": { "$ref": "#/$defs/query" },
    "chart": { "$ref": "#/$defs/chart" }
  },

  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "\\A[A-Za-z_][A-Za-z0-9_]{0,62}\\Z"
    },

    "table_ref": {
      "description": "One to three segments, catalog.schema.table. A source with a single namespace uses one.",
      "type": "string",
      "pattern": "\\A[A-Za-z_][A-Za-z0-9_]{0,62}(\\.[A-Za-z_][A-Za-z0-9_]{0,62}){0,2}\\Z"
    },

    "column_ref": {
      "description": "An optional table reference plus a column, so at most four segments. The last segment is always the column, which is why a reference is split from the right.",
      "type": "string",
      "pattern": "\\A[A-Za-z_][A-Za-z0-9_]{0,62}(\\.[A-Za-z_][A-Za-z0-9_]{0,62}){0,3}\\Z"
    },

    "scalar": {
      "type": ["string", "number", "boolean", "null"]
    },

    "query": {
      "type": "object",
      "required": ["from", "limit"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/$defs/table_ref" },
        "joins": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/join" }
        },
        "filters": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/filter" }
        },
        "select": {
          "type": "array",
          "maxItems": 16,
          "items": { "$ref": "#/$defs/select_item" }
        },
        "group_by": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/select_item" }
        },
        "aggregates": {
          "type": "array",
          "maxItems": 8,
          "items": { "$ref": "#/$defs/aggregate" }
        },
        "order_by": {
          "type": "array",
          "maxItems": 4,
          "items": { "$ref": "#/$defs/order_by" }
        },
        "limit": {
          "description": "Row cap. On a multi series query this truncates rows, not series, so use limit_by to pick the outer dimension.",
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "limit_by": {
          "description": "Keep the top N values of one output column, ranked by a measure, then every row belonging to them.",
          "type": "object",
          "required": ["column", "limit", "by"],
          "additionalProperties": false,
          "properties": {
            "column": { "$ref": "#/$defs/identifier" },
            "by": { "$ref": "#/$defs/identifier" },
            "limit": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "direction": { "enum": ["asc", "desc"], "default": "desc" }
          }
        }
      }
    },

    "join": {
      "type": "object",
      "required": ["table", "on"],
      "additionalProperties": false,
      "properties": {
        "table": { "$ref": "#/$defs/table_ref" },
        "type": { "enum": ["inner", "left"], "default": "inner" },
        "on": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": ["left", "right"],
            "additionalProperties": false,
            "properties": {
              "left": { "$ref": "#/$defs/column_ref" },
              "right": { "$ref": "#/$defs/column_ref" }
            }
          }
        }
      }
    },

    "filter": {
      "description": "The op decides the shape of value. Stated as conditionals rather than a oneOf, because a oneOf reports only that nothing matched, and these messages are read by a model on retry.",
      "type": "object",
      "required": ["column", "op"],
      "additionalProperties": false,
      "properties": {
        "column": { "$ref": "#/$defs/column_ref" },
        "op": {
          "enum": ["=", "!=", "<", "<=", ">", ">=", "in", "not_in", "is_null", "is_not_null"]
        },
        "value": {}
      },
      "allOf": [
        {
          "if": { "required": ["op"], "properties": { "op": { "enum": ["in", "not_in"] } } },
          "then": {
            "required": ["value"],
            "properties": {
              "value": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": { "$ref": "#/$defs/scalar" }
              }
            }
          }
        },
        {
          "if": {
            "required": ["op"],
            "properties": { "op": { "enum": ["=", "!=", "<", "<=", ">", ">="] } }
          },
          "then": {
            "required": ["value"],
            "properties": { "value": { "$ref": "#/$defs/scalar" } }
          }
        }
      ]
    },

    "select_item": {
      "type": "object",
      "required": ["column"],
      "additionalProperties": false,
      "properties": {
        "column": { "$ref": "#/$defs/column_ref" },
        "truncate": { "enum": ["year", "quarter", "month", "week", "day", "hour"] },
        "as": { "$ref": "#/$defs/identifier" }
      }
    },

    "aggregate": {
      "description": "count with no column is a row count. Every other function needs a column, expressed as a conditional so the error names the missing property.",
      "type": "object",
      "required": ["fn", "as"],
      "additionalProperties": false,
      "properties": {
        "fn": { "enum": ["sum", "avg", "min", "max", "count", "count_distinct"] },
        "column": { "$ref": "#/$defs/column_ref" },
        "as": { "$ref": "#/$defs/identifier" }
      },
      "if": {
        "required": ["fn"],
        "properties": { "fn": { "not": { "const": "count" } } }
      },
      "then": { "required": ["column"] }
    },

    "order_by": {
      "type": "object",
      "required": ["column"],
      "additionalProperties": false,
      "properties": {
        "column": { "$ref": "#/$defs/identifier" },
        "direction": { "enum": ["asc", "desc"], "default": "asc" }
      }
    },

    "chart": {
      "type": "object",
      "required": ["mark", "encoding"],
      "additionalProperties": false,
      "properties": {
        "mark": { "enum": ["bar", "line", "area", "point", "arc"] },
        "stack": { "type": "boolean" },
        "encoding": { "$ref": "#/$defs/encoding" }
      }
    },

    "encoding": {
      "type": "object",
      "required": ["y"],
      "additionalProperties": false,
      "properties": {
        "x": { "$ref": "#/$defs/channel" },
        "y": { "$ref": "#/$defs/channel" },
        "color": { "$ref": "#/$defs/channel" }
      }
    },

    "channel": {
      "type": "object",
      "required": ["field", "type"],
      "additionalProperties": false,
      "properties": {
        "field": { "$ref": "#/$defs/identifier" },
        "type": { "enum": ["nominal", "ordinal", "quantitative", "temporal"] },
        "title": { "type": "string", "maxLength": 120 }
      }
    }
  }
}
