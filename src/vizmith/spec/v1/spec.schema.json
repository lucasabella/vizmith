{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vizmith.dev/spec/v1/spec.schema.json",
  "title": "Vizmith visualisation spec, version 1",
  "type": "object",
  "required": [
    "spec_version",
    "query",
    "chart"
  ],
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "const": "1"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "query": {
      "$ref": "#/$defs/query"
    },
    "chart": {
      "$ref": "#/$defs/chart"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "\\A[A-Za-z_][A-Za-z0-9_]{0,62}\\Z"
    },
    "table_ref": {
      "description": "One to three segments, catalog.schema.table. A source with a single namespace uses one.",
      "type": "string",
      "pattern": "\\A[A-Za-z_][A-Za-z0-9_]{0,62}(\\.[A-Za-z_][A-Za-z0-9_]{0,62}){0,2}\\Z"
    },
    "column_ref": {
      "description": "An optional table reference plus a column, so at most four segments. The last segment is always the column, which is why a reference is split from the right.",
      "type": "string",
      "pattern": "\\A[A-Za-z_][A-Za-z0-9_]{0,62}(\\.[A-Za-z_][A-Za-z0-9_]{0,62}){0,3}\\Z"
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "relative": {
      "description": "A moment the builder resolves when it compiles the query, rather than one somebody wrote down. The spec on disk stays relative and the statement it compiles to is absolute, which is what lets a saved dashboard keep meaning what it meant. `now` is this instant, `today` is midnight this morning, `start_of` is the beginning of the current unit, and `ago` is a whole number of units before now. Nothing here is an expression: the tokens are a closed set and the arithmetic is the builder's.",
      "type": "object",
      "required": [
        "relative"
      ],
      "additionalProperties": false,
      "properties": {
        "relative": {
          "enum": [
            "now",
            "today",
            "start_of",
            "ago"
          ]
        },
        "unit": {
          "enum": [
            "year",
            "quarter",
            "month",
            "week",
            "day",
            "hour"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "relative"
            ],
            "properties": {
              "relative": {
                "const": "start_of"
              }
            }
          },
          "then": {
            "required": [
              "unit"
            ]
          }
        },
        {
          "if": {
            "required": [
              "relative"
            ],
            "properties": {
              "relative": {
                "const": "ago"
              }
            }
          },
          "then": {
            "required": [
              "unit",
              "count"
            ]
          }
        }
      ]
    },
    "query": {
      "type": "object",
      "required": [
        "from",
        "limit"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/table_ref"
        },
        "joins": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/join"
          }
        },
        "filters": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/filter"
          }
        },
        "select": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/select_item"
          }
        },
        "group_by": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/select_item"
          }
        },
        "aggregates": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/aggregate"
          }
        },
        "having": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/having"
          }
        },
        "order_by": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/order_by"
          }
        },
        "limit": {
          "description": "Row cap. On a multi series query this truncates rows, not series, so use limit_by to pick the outer dimension.",
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "limit_by": {
          "description": "Keep the top N values of one output column, ranked by a measure, then every row belonging to them.",
          "type": "object",
          "required": [
            "column",
            "limit",
            "by"
          ],
          "additionalProperties": false,
          "properties": {
            "column": {
              "$ref": "#/$defs/identifier"
            },
            "by": {
              "$ref": "#/$defs/identifier"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "direction": {
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            }
          }
        }
      }
    },
    "join": {
      "type": "object",
      "required": [
        "table",
        "on"
      ],
      "additionalProperties": false,
      "properties": {
        "table": {
          "$ref": "#/$defs/table_ref"
        },
        "type": {
          "enum": [
            "inner",
            "left"
          ],
          "default": "inner"
        },
        "on": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "left",
              "right"
            ],
            "additionalProperties": false,
            "properties": {
              "left": {
                "$ref": "#/$defs/column_ref"
              },
              "right": {
                "$ref": "#/$defs/column_ref"
              }
            }
          }
        }
      }
    },
    "filter": {
      "description": "The op decides the shape of value. Stated as conditionals rather than a oneOf, because a oneOf reports only that nothing matched, and these messages are read by a model on retry.",
      "type": "object",
      "required": [
        "column",
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "column": {
          "$ref": "#/$defs/column_ref"
        },
        "op": {
          "enum": [
            "=",
            "!=",
            "<",
            "<=",
            ">",
            ">=",
            "in",
            "not_in",
            "is_null",
            "is_not_null"
          ]
        },
        "value": {}
      },
      "allOf": [
        {
          "if": {
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "enum": [
                  "in",
                  "not_in"
                ]
              }
            }
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "$ref": "#/$defs/scalar"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "enum": [
                  "=",
                  "!=",
                  "<",
                  "<=",
                  ">",
                  ">="
                ]
              }
            }
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null",
                  "object"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/relative"
              }
            }
          }
        }
      ]
    },
    "having": {
      "description": "A condition on a measure, applied after the rows are grouped. `aggregate` names one of the query's own aggregate aliases rather than a column, because what it compares is the aggregated value and not the values that went into it. A filter is the other one: it applies before grouping and names a column.",
      "type": "object",
      "required": [
        "aggregate",
        "op",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "aggregate": {
          "$ref": "#/$defs/identifier"
        },
        "op": {
          "enum": [
            "=",
            "!=",
            "<",
            "<=",
            ">",
            ">="
          ]
        },
        "value": {
          "type": [
            "string",
            "number"
          ]
        }
      }
    },
    "select_item": {
      "type": "object",
      "required": [
        "column"
      ],
      "additionalProperties": false,
      "properties": {
        "column": {
          "$ref": "#/$defs/column_ref"
        },
        "truncate": {
          "enum": [
            "year",
            "quarter",
            "month",
            "week",
            "day",
            "hour"
          ]
        },
        "as": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "aggregate": {
      "description": "count with no column is a row count. Every other function needs a column, expressed as a conditional so the error names the missing property.",
      "type": "object",
      "required": [
        "fn",
        "as"
      ],
      "additionalProperties": false,
      "properties": {
        "fn": {
          "enum": [
            "sum",
            "avg",
            "min",
            "max",
            "count",
            "count_distinct"
          ]
        },
        "column": {
          "$ref": "#/$defs/column_ref"
        },
        "as": {
          "$ref": "#/$defs/identifier"
        }
      },
      "if": {
        "required": [
          "fn"
        ],
        "properties": {
          "fn": {
            "not": {
              "const": "count"
            }
          }
        }
      },
      "then": {
        "required": [
          "column"
        ]
      }
    },
    "order_by": {
      "type": "object",
      "required": [
        "column"
      ],
      "additionalProperties": false,
      "properties": {
        "column": {
          "$ref": "#/$defs/identifier"
        },
        "direction": {
          "enum": [
            "asc",
            "desc"
          ],
          "default": "asc"
        }
      }
    },
    "chart": {
      "type": "object",
      "required": [
        "mark",
        "encoding"
      ],
      "additionalProperties": false,
      "properties": {
        "mark": {
          "enum": [
            "bar",
            "line",
            "area",
            "point",
            "arc"
          ]
        },
        "stack": {
          "type": "boolean"
        },
        "encoding": {
          "$ref": "#/$defs/encoding"
        }
      }
    },
    "encoding": {
      "type": "object",
      "required": [
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "$ref": "#/$defs/channel"
        },
        "y": {
          "$ref": "#/$defs/channel"
        },
        "color": {
          "$ref": "#/$defs/channel"
        }
      }
    },
    "channel": {
      "type": "object",
      "required": [
        "field",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "nominal",
            "ordinal",
            "quantitative",
            "temporal"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "format": {
          "$ref": "#/$defs/format"
        }
      }
    },
    "format": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "number",
            "percent",
            "currency",
            "unit"
          ]
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "group": {
          "type": "boolean"
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "currency",
                  "unit"
                ]
              }
            }
          },
          "then": {
            "required": [
              "symbol"
            ]
          },
          "else": {
            "not": {
              "required": [
                "symbol"
              ]
            }
          }
        }
      ]
    }
  }
}
