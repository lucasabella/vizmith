{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vizmith.dev/spec/v1/spec.schema.json",
  "title": "Vizmith visualisation spec, version 1",
  "type": "object",
  "required": [
    "spec_version",
    "query",
    "chart"
  ],
  "additionalProperties": false,
  "properties": {
    "spec_version": {
      "const": "1"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "query": {
      "$ref": "#/$defs/query"
    },
    "chart": {
      "$ref": "#/$defs/chart"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "\\A[A-Za-z_][A-Za-z0-9_]{0,62}\\Z"
    },
    "table_ref": {
      "description": "One to three segments, catalog.schema.table. A source with a single namespace uses one.",
      "type": "string",
      "pattern": "\\A[A-Za-z_][A-Za-z0-9_]{0,62}(\\.[A-Za-z_][A-Za-z0-9_]{0,62}){0,2}\\Z"
    },
    "column_ref": {
      "description": "An optional table reference plus a column, so at most four segments. The last segment is always the column, which is why a reference is split from the right.",
      "type": "string",
      "pattern": "\\A[A-Za-z_][A-Za-z0-9_]{0,62}(\\.[A-Za-z_][A-Za-z0-9_]{0,62}){0,3}\\Z"
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "boolean",
        "null"
      ]
    },
    "relative": {
      "description": "A moment the builder resolves when it compiles the query, rather than one somebody wrote down. The spec on disk stays relative and the statement it compiles to is absolute, which is what lets a saved dashboard keep meaning what it meant. `now` is this instant, `today` is midnight this morning, `start_of` is the beginning of the current unit, and `ago` is a whole number of units before now. Nothing here is an expression: the tokens are a closed set and the arithmetic is the builder's.",
      "type": "object",
      "required": [
        "relative"
      ],
      "additionalProperties": false,
      "properties": {
        "relative": {
          "enum": [
            "now",
            "today",
            "start_of",
            "ago"
          ]
        },
        "unit": {
          "enum": [
            "year",
            "quarter",
            "month",
            "week",
            "day",
            "hour"
          ]
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "relative"
            ],
            "properties": {
              "relative": {
                "const": "start_of"
              }
            }
          },
          "then": {
            "required": [
              "unit"
            ]
          }
        },
        {
          "if": {
            "required": [
              "relative"
            ],
            "properties": {
              "relative": {
                "const": "ago"
              }
            }
          },
          "then": {
            "required": [
              "unit",
              "count"
            ]
          }
        }
      ]
    },
    "query": {
      "type": "object",
      "required": [
        "from",
        "limit"
      ],
      "additionalProperties": false,
      "properties": {
        "from": {
          "$ref": "#/$defs/table_ref"
        },
        "joins": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/join"
          }
        },
        "filters": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/filter"
          }
        },
        "select": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/select_item"
          }
        },
        "group_by": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/select_item"
          }
        },
        "aggregates": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/aggregate"
          }
        },
        "having": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/having"
          }
        },
        "windows": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/window"
          }
        },
        "order_by": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/order_by"
          }
        },
        "limit": {
          "description": "Row cap. On a multi series query this truncates rows, not series, so use limit_by to pick the outer dimension.",
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "limit_by": {
          "description": "Keep the top N values of one output column, ranked by a measure, then every row belonging to them.",
          "type": "object",
          "required": [
            "column",
            "limit",
            "by"
          ],
          "additionalProperties": false,
          "properties": {
            "column": {
              "$ref": "#/$defs/identifier"
            },
            "by": {
              "$ref": "#/$defs/identifier"
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "direction": {
              "enum": [
                "asc",
                "desc"
              ],
              "default": "desc"
            }
          }
        }
      }
    },
    "join": {
      "type": "object",
      "required": [
        "table",
        "on"
      ],
      "additionalProperties": false,
      "properties": {
        "table": {
          "$ref": "#/$defs/table_ref"
        },
        "type": {
          "enum": [
            "inner",
            "left"
          ],
          "default": "inner"
        },
        "on": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "left",
              "right"
            ],
            "additionalProperties": false,
            "properties": {
              "left": {
                "$ref": "#/$defs/column_ref"
              },
              "right": {
                "$ref": "#/$defs/column_ref"
              }
            }
          }
        }
      }
    },
    "filter": {
      "description": "A condition, or a disjunction of them. One level and no recursion: the compiled WHERE is a conjunction of clauses where a clause may be an OR, which covers the questions people ask without opening the grammar to arbitrary boolean trees. Stated as if/then/else rather than a oneOf for the same reason the condition below is: a oneOf reports only that nothing matched, and these messages are read by a model on retry.",
      "if": {
        "type": "object",
        "required": [
          "any"
        ]
      },
      "then": {
        "$ref": "#/$defs/disjunction"
      },
      "else": {
        "$ref": "#/$defs/condition"
      }
    },
    "disjunction": {
      "type": "object",
      "required": [
        "any"
      ],
      "additionalProperties": false,
      "properties": {
        "any": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/condition"
          }
        }
      }
    },
    "condition": {
      "description": "The op decides the shape of value. Stated as conditionals rather than a oneOf, because a oneOf reports only that nothing matched, and these messages are read by a model on retry.",
      "type": "object",
      "required": [
        "column",
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "column": {
          "$ref": "#/$defs/column_ref"
        },
        "op": {
          "enum": [
            "=",
            "!=",
            "<",
            "<=",
            ">",
            ">=",
            "in",
            "not_in",
            "is_null",
            "is_not_null"
          ]
        },
        "value": {}
      },
      "allOf": [
        {
          "if": {
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "enum": [
                  "in",
                  "not_in"
                ]
              }
            }
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100,
                "items": {
                  "$ref": "#/$defs/scalar"
                }
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "op"
            ],
            "properties": {
              "op": {
                "enum": [
                  "=",
                  "!=",
                  "<",
                  "<=",
                  ">",
                  ">="
                ]
              }
            }
          },
          "then": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null",
                  "object"
                ]
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "type": "object"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "$ref": "#/$defs/relative"
              }
            }
          }
        }
      ]
    },
    "having": {
      "description": "A condition on a measure, applied after the rows are grouped. `aggregate` names one of the query's own aggregate aliases rather than a column, because what it compares is the aggregated value and not the values that went into it. A filter is the other one: it applies before grouping and names a column.",
      "type": "object",
      "required": [
        "aggregate",
        "op",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "aggregate": {
          "$ref": "#/$defs/identifier"
        },
        "op": {
          "enum": [
            "=",
            "!=",
            "<",
            "<=",
            ">",
            ">="
          ]
        },
        "value": {
          "type": [
            "string",
            "number"
          ]
        }
      }
    },
    "window": {
      "description": "One row of the result read against the others: a running total, a share of the total, a rank, the value one row back, the difference from it, or that difference as a proportion. `of` names one of the query's own aggregate aliases, because what a window compares is a measure. `partition_by` names the dimensions the comparison restarts inside, so a running total can be per category rather than one line across all of them. `along` names the output column the rows are walked in, which the four ordered functions require and which `share` and `rank` refuse: a share is over a whole partition and a rank is over its own measure. `direction` is what the word means unless it says otherwise — a rank counts down from the largest, an ordered walk goes forwards.",
      "type": "object",
      "required": [
        "fn",
        "of",
        "as"
      ],
      "additionalProperties": false,
      "properties": {
        "fn": {
          "enum": [
            "running_total",
            "share",
            "rank",
            "previous",
            "difference",
            "change"
          ]
        },
        "of": {
          "$ref": "#/$defs/identifier"
        },
        "along": {
          "$ref": "#/$defs/identifier"
        },
        "partition_by": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier"
          }
        },
        "direction": {
          "enum": [
            "asc",
            "desc"
          ]
        },
        "as": {
          "$ref": "#/$defs/identifier"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "fn"
            ],
            "properties": {
              "fn": {
                "enum": [
                  "running_total",
                  "previous",
                  "difference",
                  "change"
                ]
              }
            }
          },
          "then": {
            "required": [
              "along"
            ]
          },
          "else": {
            "not": {
              "required": [
                "along"
              ]
            }
          }
        }
      ]
    },
    "operand": {
      "description": "One side of a computed column: a column reference, or a number bound as a parameter like every other value. A number on the left is legal because '-' and '/' are not commutative, so '1 - rate' is a question and '(1 - rate)' written the other way round is a different one.",
      "type": [
        "string",
        "number"
      ],
      "if": {
        "type": "string"
      },
      "then": {
        "$ref": "#/$defs/column_ref"
      }
    },
    "expression": {
      "description": "A computed column: one operation over two operands, and nothing else. No nesting, no function calls, no operator the source might read as one. A warehouse holds facts and not derived measures, so a question about revenue against a schema holding unit price and quantity could not be asked at all; this is what makes it askable without giving the model an expression language, which is the shortest path back to generated code being executed.",
      "type": "object",
      "required": [
        "left",
        "op",
        "right"
      ],
      "additionalProperties": false,
      "properties": {
        "left": {
          "$ref": "#/$defs/operand"
        },
        "op": {
          "enum": [
            "+",
            "-",
            "*",
            "/"
          ]
        },
        "right": {
          "$ref": "#/$defs/operand"
        }
      }
    },
    "select_item": {
      "description": "A column, or a computed one. An item that computes says what to call the result, because there is no column name to fall back on and the alias is what the chart binds a channel to.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "column": {
          "$ref": "#/$defs/column_ref"
        },
        "expression": {
          "$ref": "#/$defs/expression"
        },
        "truncate": {
          "enum": [
            "year",
            "quarter",
            "month",
            "week",
            "day",
            "hour"
          ]
        },
        "as": {
          "$ref": "#/$defs/identifier"
        }
      },
      "if": {
        "required": [
          "expression"
        ]
      },
      "then": {
        "required": [
          "as"
        ]
      },
      "else": {
        "required": [
          "column"
        ]
      }
    },
    "aggregate": {
      "description": "count with no column is a row count. Every other function aggregates a column or a computed one, expressed as a conditional so the error names the missing property rather than reporting that nothing matched.",
      "type": "object",
      "required": [
        "fn",
        "as"
      ],
      "additionalProperties": false,
      "properties": {
        "fn": {
          "enum": [
            "sum",
            "avg",
            "min",
            "max",
            "count",
            "count_distinct"
          ]
        },
        "column": {
          "$ref": "#/$defs/column_ref"
        },
        "expression": {
          "$ref": "#/$defs/expression"
        },
        "as": {
          "$ref": "#/$defs/identifier"
        }
      },
      "if": {
        "required": [
          "fn"
        ],
        "properties": {
          "fn": {
            "not": {
              "const": "count"
            }
          }
        },
        "not": {
          "required": [
            "expression"
          ]
        }
      },
      "then": {
        "required": [
          "column"
        ]
      }
    },
    "order_by": {
      "type": "object",
      "required": [
        "column"
      ],
      "additionalProperties": false,
      "properties": {
        "column": {
          "$ref": "#/$defs/identifier"
        },
        "direction": {
          "enum": [
            "asc",
            "desc"
          ],
          "default": "asc"
        }
      }
    },
    "chart": {
      "type": "object",
      "required": [
        "mark",
        "encoding"
      ],
      "additionalProperties": false,
      "properties": {
        "mark": {
          "enum": [
            "bar",
            "line",
            "area",
            "point",
            "arc"
          ]
        },
        "stack": {
          "type": "boolean"
        },
        "encoding": {
          "$ref": "#/$defs/encoding"
        }
      }
    },
    "encoding": {
      "type": "object",
      "required": [
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "$ref": "#/$defs/channel"
        },
        "y": {
          "$ref": "#/$defs/channel"
        },
        "color": {
          "$ref": "#/$defs/channel"
        }
      }
    },
    "channel": {
      "type": "object",
      "required": [
        "field",
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "field": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "nominal",
            "ordinal",
            "quantitative",
            "temporal"
          ]
        },
        "title": {
          "type": "string",
          "maxLength": 120
        },
        "format": {
          "$ref": "#/$defs/format"
        }
      }
    },
    "format": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "number",
            "percent",
            "currency",
            "unit"
          ]
        },
        "decimals": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "group": {
          "type": "boolean"
        },
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "currency",
                  "unit"
                ]
              }
            }
          },
          "then": {
            "required": [
              "symbol"
            ]
          },
          "else": {
            "not": {
              "required": [
                "symbol"
              ]
            }
          }
        }
      ]
    }
  }
}
