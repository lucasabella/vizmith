{
  "spec_version": "1",
  "title": "Share of revenue per country",
  "query": {
    "from": "orders",
    "joins": [
      { "table": "customers", "on": [{ "left": "orders.customer_id", "right": "customers.id" }] }
    ],
    "group_by": [{ "column": "customers.country" }],
    "aggregates": [{ "fn": "sum", "column": "orders.total", "as": "revenue" }],
    "windows": [{ "fn": "share", "of": "revenue", "as": "share_of_revenue" }],
    "order_by": [{ "column": "revenue", "direction": "desc" }],
    "limit_by": { "column": "country", "by": "revenue", "limit": 10, "direction": "desc" },
    "limit": 500
  },
  "chart": {
    "mark": "bar",
    "encoding": {
      "x": { "field": "country", "type": "nominal" },
      "y": {
        "field": "share_of_revenue",
        "type": "quantitative",
        "title": "Share of the revenue drawn",
        "format": { "kind": "percent", "decimals": 1 }
      }
    }
  }
}
