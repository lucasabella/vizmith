{
  "spec_version": "1",
  "title": "Orders per month",
  "query": {
    "from": "orders",
    "filters": [{ "column": "order_date", "op": "is_not_null" }],
    "group_by": [{ "column": "order_date", "truncate": "month", "as": "month" }],
    "aggregates": [{ "fn": "count", "as": "orders" }],
    "order_by": [{ "column": "month", "direction": "asc" }],
    "limit": 60
  },
  "chart": {
    "mark": "line",
    "encoding": {
      "x": { "field": "month", "type": "temporal" },
      "y": { "field": "orders", "type": "quantitative" }
    }
  }
}
