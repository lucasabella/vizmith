{
  "spec_version": "1",
  "query": {
    "from": "orders",
    "joins": [
      {
        "table": "customers",
        "on": [
          {
            "left": "orders.customer_id",
            "right": "customers.id"
          }
        ]
      }
    ],
    "group_by": [
      {
        "column": "country"
      }
    ],
    "aggregates": [
      {
        "fn": "sum",
        "column": "orders.total",
        "as": "revenue"
      }
    ],
    "limit": 10
  },
  "chart": {
    "mark": "bar",
    "encoding": {
      "x": {
        "field": "country",
        "type": "nominal"
      },
      "y": {
        "field": "revenue",
        "type": "quantitative"
      }
    }
  }
}
