{
  "spec_version": "1",
  "title": "A number rounded to a month",
  "query": {
    "from": "orders",
    "group_by": [
      {
        "expression": { "left": "orders.total", "op": "-", "right": "orders.item_count" },
        "truncate": "month",
        "as": "difference"
      }
    ],
    "aggregates": [{ "fn": "count", "as": "order_count" }],
    "limit": 20
  },
  "chart": {
    "mark": "bar",
    "encoding": {
      "x": { "field": "difference", "type": "nominal" },
      "y": { "field": "order_count", "type": "quantitative" }
    }
  }
}
