{
  "spec_version": "1",
  "title": "Revenue per country, as a share of itself",
  "query": {
    "from": "vizmith.shop.orders",
    "group_by": [{ "column": "country" }],
    "aggregates": [{ "fn": "sum", "column": "total", "as": "revenue" }],
    "windows": [{ "fn": "share", "of": "revenue", "partition_by": ["country"], "as": "share_of_revenue" }],
    "limit": 500
  },
  "chart": {
    "mark": "bar",
    "encoding": {
      "x": { "field": "country", "type": "nominal" },
      "y": { "field": "share_of_revenue", "type": "quantitative" }
    }
  }
}
